# Development environment settings
# Loaded via: ENV_FILE=.env.dev (default fallback is .env)

# Database
DATABASE_URL=sqlite:///./graveyard.db

# Security
SECRET_KEY=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Admin login (used by /v1/auth/token)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# API Keys
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_VISION_API_KEY=your-google-vision-key
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# AI Model
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite

# Rate Limiting
RATE_LIMIT_FREE_TIER=50
RATE_LIMIT_PRO_TIER=500

# Image Processing
IMAGE_UPLOAD_MAX_SIZE_MB=10
IMAGE_RETENTION_SECONDS=30

# CORS
CORS_ORIGINS=["http://localhost","http://localhost:3000"]

# App metadata
APP_NAME=Saved Content Graveyard
APP_VERSION=0.1.0
DEBUG=True