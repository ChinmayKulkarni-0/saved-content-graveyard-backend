# Production environment settings
# Loaded via: ENV_FILE=.env.prod

# Database
DATABASE_URL=postgresql://user:password@prod-db:5432/prod_db

# Security
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Admin login (used by /v1/auth/token)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

# API Keys
OPENAI_API_KEY=sk-your-openai-key
GOOGLE_VISION_API_KEY=your-google-vision-key
GOOGLE_GEMINI_API_KEY=your-gemini-api-key

# AI Model
GEMINI_MODEL=gemini-2.0-flash
GEMINI_MODEL_FALLBACK=gemini-2.0-flash-lite

# Rate Limiting (free tier rates are strict in production)
RATE_LIMIT_FREE_TIER=10
RATE_LIMIT_PRO_TIER=100

# Image Processing
IMAGE_UPLOAD_MAX_SIZE_MB=10
IMAGE_RETENTION_SECONDS=30

# CORS (restrict to real frontend origins)
CORS_ORIGINS=["https://app.savedcontentgraveyard.com"]

# App metadata
APP_NAME=Saved Content Graveyard
APP_VERSION=0.1.0
DEBUG=False